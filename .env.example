# Copy to .env and fill in. Never commit .env.

# --- Credentials (required) ---
# API key from BlazeMeter > Settings > API Keys, as <key_id>:<key_secret>
BZM_API_KEY=
# BZM_API_URL=https://a.blazemeter.com/api/v4

# --- Where the test lives (required) ---
PROJECT_ID=

# --- Which test to run ---
# Set TEST_ID to run an existing test. Leave it empty to reuse the test called TEST_NAME
# in PROJECT_ID, or create it (TEST_FILE_PATH is then required).
TEST_ID=
TEST_NAME=BlazeDemo smoke test

# --- Files (uploaded on every run when APPLY_OVERRIDES=true) ---
TEST_FILE_PATH=tests/blazedemo_smoke.jmx
# Comma-separated extra files, e.g. tests/users.csv,tests/products.csv
TEST_DATA_PATH=

# --- Load profile (required when APPLY_OVERRIDES=true) ---
# Hold-for, in minutes
TEST_DURATION=2
TEST_CONCURRENCY=2
# Ramp-up, in minutes
TEST_RAMP_UP=0
# Optional single location, e.g. us-east4-a or harbor-xxxxxxxx (private location).
# If empty, the test's current location split is kept and VUs are spread across it.
LOCATION_ID=

# true: upload files and apply the load profile above before each run (changes the saved test).
# false: run TEST_ID exactly as configured in the BlazeMeter UI.
APPLY_OVERRIDES=true

# --- Monitoring and results ---
OUTPUT_DIR=blazemeter
# Seconds between status polls
MONITORING_INTERVAL=30
# Seconds; default is (TEST_DURATION + TEST_RAMP_UP) minutes + 15 min, or 2h if no duration
MONITOR_TIMEOUT=
VERBOSE_MONITORING=false
# true: fail the job when the test has no failure criteria
FAIL_ON_NO_CRITERIA=false
DOWNLOAD_LOGS=true
